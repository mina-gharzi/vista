// VISTA — Database Schema
// طبق بخش ۱۵ پرامپت مادر: Normalize، Constraint، Foreign Key، Unique و Index مناسب.
//
// قرارداد پولی: تمام مبالغ «عدد صحیح به واحد تومان» هستند (Int) — بدون اعشار و بدون خطای Float.
// Constraintهایی که Prisma بیان نمی‌کند (CHECK) در فایل Migration به‌صورت SQL خام اضافه می‌شوند
// (نگاه کنید به backend/prisma/checks.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & Users
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller        Seller?
  cart          Cart?
  wishlist      Wishlist?
  orders             Order[]
  reviews            Review[]
  addresses          Address[]
  refreshTokens      RefreshToken[]
  inventoryMovements InventoryMovement[]
  sellerOrderEvents  SellerOrderEvent[]
  adminAuditLogs     AdminAuditLog[]    @relation("AdminAuditActor")
  couponRedemptions  CouponRedemption[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // هش توکن ذخیره می‌شود، نه مقدار خام (بخش ۱۸ پرامپت مادر)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  // درخواست رد شده؛ کاربر می‌تواند با اصلاح اطلاعات دوباره درخواست دهد (همان رکورد Seller به PENDING برمی‌گردد)
  REJECTED
}

model Seller {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  storeSlug   String       @unique
  description String?
  status      SellerStatus @default(PENDING)
  // دلیل آخرین رد/تعلیق توسط ادمین؛ با تأیید یا ارسال مجدد null می‌شود
  statusReason    String?
  statusChangedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products     Product[]
  sellerOrders SellerOrder[]
  coupons      Coupon[]

  @@map("sellers")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  province   String
  city       String
  postalCode String
  addressLine String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  // نمایش عمومی محدود به isActive=true؛ حذف Category بعد از انتشار (وجود Product) مجاز نیست
  isActive  Boolean    @default(true)
  // ترتیب نمایش در Nav/Listing (کوچک‌تر = اول)
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryToParent")

  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  slug        String        @unique
  description String
  // قیمت فروش فعلی (تومان). قیمت مؤثر هر Variant = variant.price ?? product.basePrice
  basePrice   Int
  // قیمت قبل از تخفیف (خط‌خورده). null یعنی محصول تخفیف ندارد. باید > basePrice باشد (CHECK)
  compareAtPrice Int?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  wishlisted WishlistItem[]

  @@index([sellerId])
  @@index([categoryId])
  // Catalog: فقط محصولات منتشرشده، جدیدترین‌ها اول
  @@index([status, createdAt])
  // Catalog: مرتب‌سازی قیمت (EXPLAIN روی ۵۰k ردیف ساختگی: Seq Scan ~12ms → Index Scan ~0.13ms)
  @@index([status, basePrice])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Source of Truth موجودی طبق بخش ۱۷ پرامپت مادر — Frontend هرگز مستقیم موجودی را تغییر نمی‌دهد
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String
  color     String
  // اگر null باشد، basePrice محصول اصلی ملاک است (تومان)
  price     Int?
  // همیشه >= 0 (CHECK). فقط از طریق Backend و داخل Transaction تغییر می‌کند
  stock     Int      @default(0)
  // برای جلوگیری از Race Condition در کسر موجودی همزمان (Optimistic Locking)
  version   Int      @default(0)
  // false = تنوع آرشیو شده: برای مشتری نمایش/فروش داده نمی‌شود ولی ردیف (و تاریخچه سفارش/انبار) حذف نمی‌شود
  isActive  Boolean  @default(true)

  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Cart & Wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  INITIAL // موجودی اولیه هنگام ساخت Variant
  RESTOCK // افزایش توسط فروشنده
  ADJUSTMENT // اصلاح دستی (شمارش انبار، خطا)
  ORDER_PLACED // کسر بابت ثبت سفارش
  ORDER_CANCELLED // برگشت بابت لغو سفارش
  RETURN // برگشت کالا
}

// دفتر کل تغییرات موجودی (Inventory History) — رکوردها هرگز ویرایش یا حذف نمی‌شوند
model InventoryMovement {
  id            String                @id @default(uuid())
  variantId     String
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  // مثبت = افزایش، منفی = کاهش
  quantityDelta Int
  // موجودی Variant بعد از اعمال همین تغییر (برای Audit سریع)
  stockAfter    Int
  reason        String?
  // کسی که تغییر را انجام داده (فروشنده/ادمین/خود مشتری هنگام سفارش)
  actorId       String?
  actor         User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // ارجاع نرم به سفارش (بدون FK تا با حذف/آرشیو سفارش، تاریخچه انبار دست‌نخورده بماند)
  orderId       String?
  createdAt     DateTime              @default(now())

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Orders (Multi-Vendor)
// ---------------------------------------------------------------------------
//
// یک Order = یک پرداخت مشتری. اگر سبد شامل کالای چند فروشنده باشد، Order به چند SellerOrder
// تقسیم می‌شود تا هر فروشنده وضعیت ارسال مستقل خودش را داشته باشد.
//   Order.status        → وضعیت پرداخت/چرخه کلی سفارش
//   SellerOrder.status  → وضعیت آماده‌سازی و ارسال بخش همان فروشنده

enum OrderStatus {
  PENDING // ثبت شده، در انتظار پرداخت
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  // شماره سفارش قابل‌نمایش به مشتری
  orderNumber Int         @unique @default(autoincrement())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  // مبالغ فقط از Server محاسبه می‌شوند، هرگز از Client پذیرفته نمی‌شوند (تومان)
  subtotal       Int
  shippingCost   Int @default(0)
  discountAmount Int @default(0)
  totalAmount    Int

  // کوپن اعمال‌شده (حداکثر یک). couponCode Snapshot است: با ویرایش یا غیرفعال‌سازی بعدی کوپن تغییر نمی‌کند.
  // هر discountAmount > 0 باید couponId داشته باشد (CHECK).
  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponCode String?

  // Snapshot آدرس در لحظه ثبت — ویرایش/حذف Address بعدی روی سفارش قبلی اثر ندارد
  shippingFullName    String
  shippingPhone       String
  shippingProvince    String
  shippingCity        String
  shippingPostalCode  String
  shippingAddressLine String

  paymentRef String?
  paidAt     DateTime?
  cancelledAt DateTime?

  // کلید یکتای هر «تلاش ثبت سفارش» که Client می‌سازد (UUID). تکرار همان کلید برای همان کاربر
  // هرگز سفارش دوم نمی‌سازد. سفارش‌های قدیمی null دارند (در Postgres چند null در ایندکس یکتا مجاز است).
  checkoutKey String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sellerOrders     SellerOrder[]
  couponRedemption CouponRedemption?

  @@unique([userId, checkoutKey])
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model SellerOrder {
  id           String            @id @default(uuid())
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller            @relation(fields: [sellerId], references: [id])
  status       FulfillmentStatus @default(PENDING)
  // جمع ناخالص کالاهای همین فروشنده (تومان، قبل از تخفیف)
  subtotal     Int
  // سهم همین فروشنده از تخفیف کوپن؛ 0 <= discountAmount <= subtotal (CHECK)
  discountAmount Int @default(0)
  trackingCode String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items  OrderItem[]
  events SellerOrderEvent[]

  // در هر سفارش، برای هر فروشنده فقط یک SellerOrder
  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@map("seller_orders")
}

// تاریخچه تغییر وضعیت ارسال هر SellerOrder (Audit Trail) — رکوردها هرگز ویرایش یا حذف نمی‌شوند
model SellerOrderEvent {
  id            String            @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  fromStatus    FulfillmentStatus
  toStatus      FulfillmentStatus
  // فقط هنگام ارسال (SHIPPED) مقدار دارد
  trackingCode  String?
  // کاربری که تغییر را انجام داده (از توکن، نه از Client)
  actorId       String?
  actor         User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([sellerOrderId, createdAt])
  @@map("seller_order_events")
}

model OrderItem {
  id            String         @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  // Restrict (پیش‌فرض): Variantی که در سفارش استفاده شده حذف نمی‌شود؛ به‌جای حذف، محصول ARCHIVED می‌شود
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  // Snapshot در لحظه سفارش — تغییر بعدی قیمت/عنوان/سایز روی سفارش قبلی اثر ندارد
  unitPrice     Int
  // سهم این ردیف از تخفیف کوپن (تومان)؛ جمع ردیف‌های یک فروشنده = SellerOrder.discountAmount
  discountAmount Int @default(0)
  productTitle  String
  sku           String
  size          String
  color         String
  imageUrl      String?
  createdAt     DateTime       @default(now())

  @@index([sellerOrderId])
  @@index([variantId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------
//
// کوپن فقط توسط ادمین مدیریت می‌شود. محدودیت‌ها: فروشنده (اختیاری) + محصول‌ها + دسته‌ها (آرایه‌ها بدون FK:
// حذف دسته/محصول هرگز محدودیت را «بازتر» نمی‌کند؛ شناسهٔ معلق فقط چیزی را مشمول نمی‌کند).
// مبالغ همه عدد صحیح تومان. قوانین بین‌فیلدی در CHECKهای Migration هم تکرار شده‌اند.

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

enum CouponRedemptionStatus {
  ACTIVE // سفارش ثبت شده و لغو نشده
  RELEASED // سفارش پرداخت‌نشده لغو شد و استفاده آزاد شد
}

model Coupon {
  id                String             @id @default(uuid())
  // نرمال‌شده: حروف بزرگ لاتین/رقم/-/_ ؛ یکتایی در سطح دیتابیس
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  // FIXED: تومان ؛ PERCENTAGE: ۱ تا ۱۰۰
  discountValue     Int
  // فقط درصدی؛ سقف تخفیف (تومان)
  maxDiscountAmount Int?
  // حداقل جمع «کالاهای مشمول» (تومان)
  minPurchaseAmount Int?
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean            @default(true)
  // null = نامحدود
  usageLimit        Int?
  perUserLimit      Int?
  // شمارندهٔ استفادهٔ فعال؛ فقط با UPDATE شرطی اتمیک تغییر می‌کند (usedCount <= usageLimit با CHECK)
  usedCount         Int                @default(0)
  sellerId          String?
  seller            Seller?            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  productIds        String[]           @default([])
  categoryIds       String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@map("coupons")
}

// هر سفارشِ دارای کوپن دقیقاً یک ردیف دارد (orderId یکتا) → ثبت سفارش تکراری هرگز دو بار مصرف نمی‌کند.
model CouponRedemption {
  id             String                 @id @default(uuid())
  couponId       String
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId        String                 @unique
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Int
  status         CouponRedemptionStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  releasedAt     DateTime?

  // شمارش سقف هر مشتری در Checkout و آمار ادمین
  @@index([couponId, userId, status])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // ۱ تا ۵ (CHECK)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

/// دفتر ممیزی اقدام‌های ادمین. فقط‌افزودنی است: Trigger دیتابیس هر UPDATE/DELETE را رد می‌کند.
/// action/targetType عمداً String هستند (افزودن نوع جدید Migration نمی‌خواهد)؛ مقادیر مجاز در @vista/shared است.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  fromStatus String?
  toStatus   String?
  reason     String?
  // جزئیات غیرحساس (مثلاً فیلدهای تغییریافتهٔ دسته)؛ هرگز رمز/توکن/اطلاعات شخصی
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}
