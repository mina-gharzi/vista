NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vista?schema=public"

# JWT — با مقادیر تصادفی حداقل ۳۲ کاراکتری واقعی جایگزین شود (مثلاً: openssl rand -hex 32)
JWT_ACCESS_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_MIN_32_CHARS_SECRET"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Frontend Origin مجاز برای CORS
CORS_ORIGIN="http://localhost:3000"
